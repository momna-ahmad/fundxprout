{
  "solidity.packageDefaultDependenciesDirectory": "blockchain/node_modules",
  "solidity.remappings": [
    "@openzeppelin/contracts/=blockchain/node_modules/@openzeppelin/contracts/",
    "@openzeppelin/=blockchain/node_modules/@openzeppelin/"
  ],
  "solidity.remappingsUnix": [
    "@openzeppelin/contracts/=blockchain/node_modules/@openzeppelin/contracts/",
    "@openzeppelin/=blockchain/node_modules/@openzeppelin/"
  ]
}